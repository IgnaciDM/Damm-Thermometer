# ==============================================================================
# PULSO - ESTRELLA DAMM WORKPLACE ANALYTICS & SURVEY ENGINE
# Variables de entorno para despliegue y desarrollo (UAB THE HACK 2026)
# ==============================================================================
# NOTA: No introduzcas claves reales en este archivo. Cópialo a .env para uso local.
# ==============================================================================

# Clave API del LLM de la UAB (Guia del LLM del DCC - UAB THE HACK 2026)
UTH_KEY=

# Modelo del DCC de la UAB (Ornith 1.5, 35B MoE servido en 8 GPU)
AI_MODEL=ornith

# URL base del cluster LLM de la UAB
AI_BASE_URL=https://dcc-llm-gw.uab.cat/uabthehack/v1/chat/completions

# Alternativa: Google Gemini API Key si se prefiere usar Gemini externamente
GEMINI_API_KEY=

# Token de Typeform (Opcional, para publicación y sincronización en la nube)
TYPEFORM_API_TOKEN=

# URL pública para generación de códigos QR de planta (Opcional, por defecto usa el host de la petición)
PULSO_PUBLIC_URL=http://127.0.0.1:8000

# Ruta de la base de datos SQLite (Opcional, por defecto data/pulso.sqlite3)
PULSO_DATABASE=data/pulso.sqlite3

# Ruta al directorio extraído del modelo Vosk de español (opcional)
VOSK_MODEL_PATH=ui/assets/vosk-model-small-es-0.42/vosk-model-small-es-0.42
